<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#5b4ee8">
<title>💰 আয়-ব্যয় হিসাব</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f4ff;color:#18223b;font-family:Arial,sans-serif}
header{background:linear-gradient(135deg,#5146e5,#8b5cf6);color:#fff;padding:22px 16px;border-radius:0 0 25px 25px}
header h1{margin:0;font-size:26px}
header p{margin:6px 0 0;opacity:.9}
nav{display:flex;gap:7px;overflow:auto;padding:10px;position:sticky;top:0;background:#f3f4ff;z-index:5}
nav button{width:auto;white-space:nowrap;border:0;background:#fff;color:#333;padding:11px 15px;border-radius:22px;margin:0}
nav button.active{background:#5b4ee8;color:#fff}
.container{max-width:760px;margin:auto;padding:12px}
.card{background:#fff;border-radius:20px;padding:17px;margin:14px 0;box-shadow:0 4px 18px #0001}
h2{margin:0 0 14px}
input,select,button{width:100%;padding:13px;margin:5px 0;border:1px solid #d8dbea;border-radius:12px;font-size:15px}
button{background:#5b4ee8;color:#fff;border:0;font-weight:bold}
button.red{background:#ef4444}
button.green{background:#16a34a}
button.gray{background:#e8e7ff;color:#4438b8}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stat{background:#f5f4ff;padding:14px;border-radius:14px;text-align:center}
.stat b{display:block;font-size:20px;margin-bottom:4px}
.balance{padding:14px;border-radius:14px;margin:8px 0;display:flex;justify-content:space-between;gap:8px}
.greenbg{background:#dcfce7;color:#166534}
.redbg{background:#fee2e2;color:#991b1b}
.bluebg{background:#e0f2fe;color:#075985}
.small{font-size:12px;color:#64748b}
.hidden{display:none}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:8px 5px;border-bottom:1px solid #eee;text-align:left}
th{background:#f5f4ff}
.actions{display:flex;gap:5px}
.actions button{width:auto;padding:8px 10px}
@media(max-width:500px){.grid,.stats{grid-template-columns:1fr}}
@media print{nav,.no-print,header p{display:none!important}body{background:#fff}.card{box-shadow:none;border:1px solid #ddd}}
</style>
</head>
<body>

<header>
<h1>💰 আমার আয়-ব্যয় হিসাব</h1>
<p>Euro (€) • মাসভিত্তিক • অটো হিসাব</p>
</header>

<nav>
<button class="active" onclick="show('home',this)">📊 Summary</button>
<button onclick="show('income',this)">💵 আয়</button>
<button onclick="show('expense',this)">💸 খরচ</button>
<button onclick="show('people',this)">👥 পাওনা/দেনা</button>
<button onclick="show('report',this)">📄 Report</button>
</nav>

<div class="container">

<section id="home">
<div class="card">
<h2>📅 মাস নির্বাচন</h2>
<input type="month" id="month">
</div>

<div class="card">
<h2>📊 মাসের হিসাব</h2>
<div id="summary"></div>
</div>

<div class="card">
<h2>👥 পাওনা / দেনা</h2>
<div id="peopleSummary"></div>
</div>
</section>

<section id="income" class="hidden">
<div class="card">
<h2>💵 আয় যোগ করুন</h2>
<input type="date" id="incomeDate">
<select id="incomeType">
<option value="job">💵 চাকরি থেকে আয়</option>
<option value="car">🚗 গাড়ি চালিয়ে আয়</option>
<option value="other">💰 অন্যান্য আয়</option>
</select>
<input id="incomeNote" placeholder="বিবরণ">
<input type="number" id="incomeAmount" step="0.01" placeholder="কত €">
<button onclick="addIncome()">＋ আয় যোগ করুন</button>
</div>
<div class="card">
<h2>📜 আয়ের তালিকা</h2>
<div id="incomeList"></div>
</div>
</section>

<section id="expense" class="hidden">
<div class="card">
<h2>💸 খরচ যোগ করুন</h2>
<input type="date" id="expenseDate">
<select id="expenseType">
<option value="fuel">🚗 গাড়ি — তেল</option>
<option value="repair">🔧 গাড়ি — মেরামত</option>
<option value="insurance">🛡️ গাড়ি — Insurance</option>
<option value="tax">📄 গাড়ি — Tax</option>
<option value="carOther">🚗 গাড়ি — অন্যান্য</option>
<option value="home">🏠 বাসা / ব্যক্তিগত</option>
<option value="food">🍔 খাবার / দৈনন্দিন</option>
<option value="other">💸 অন্যান্য</option>
</select>
<input id="expenseNote" placeholder="বিবরণ">
<input type="number" id="expenseAmount" step="0.01" placeholder="কত €">
<button onclick="addExpense()">＋ খরচ যোগ করুন</button>
</div>
<div class="card">
<h2>📜 খরচের তালিকা</h2>
<div id="expenseList"></div>
</div>
</section>

<section id="people" class="hidden">
<div class="card">
<h2>💰 আমার কাছে কে টাকা পাবে</h2>
<input id="oweName" placeholder="নাম">
<input type="number" id="oweAmount" step="0.01" placeholder="কত €">
<input type="date" id="oweDate">
<input id="oweNote" placeholder="বিবরণ">
<button onclick="addOwe()">＋ যোগ করুন</button>
</div>

<div class="card">
<h2>💸 আমি কার কাছে টাকা পাব</h2>
<input id="getName" placeholder="নাম">
<input type="number" id="getAmount" step="0.01" placeholder="কত €">
<input type="date" id="getDate">
<input id="getNote" placeholder="বিবরণ">
<button onclick="addGet()">＋ যোগ করুন</button>
</div>

<div class="card">
<h2>📜 তালিকা</h2>
<div id="peopleList"></div>
</div>
</section>

<section id="report" class="hidden">
<div class="card">
<h2>📄 Monthly Report</h2>
<div id="report"></div>
<button class="green no-print" onclick="window.print()">📄 PDF / Print</button>
</div>

<div class="card no-print">
<h2>💾 Backup</h2>
<button onclick="backup()">💾 Backup Save</button>
<button class="gray" onclick="document.getElementById('restore').click()">📥 Restore</button>
<input type="file" id="restore" accept=".json" style="display:none" onchange="restore(event)">
<button class="red" onclick="clearAll()">🗑️ সব হিসাব মুছুন</button>
</div>
</section>

</div>

<script>
const KEY="MY_INCOME_EXPENSE_V2";

let db=JSON.parse(localStorage.getItem(KEY)||"null")||{
 income:[],
 expense:[],
 owe:[],
 get:[]
};

function save(){
localStorage.setItem(KEY,JSON.stringify(db));
render();
}

function today(){
return new Date().toISOString().slice(0,10);
}

function month(){
return document.getElementById("month").value;
}

function money(n){
return "€"+Number(n||0).toFixed(2);
}

function esc(x){
return String(x||"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;");
}

function inMonth(d){
return d&&d.slice(0,7)===month();
}

function show(id,btn){
document.querySelectorAll("section").forEach(x=>x.classList.add("hidden"));
document.getElementById(id).classList.remove("hidden");
document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
btn.classList.add("active");
}

function addIncome(){
let amount=+incomeAmount.value;
if(amount<=0)return alert("টাকার পরিমাণ দিন");
db.income.push({
id:Date.now(),
date:incomeDate.value||today(),
type:incomeType.value,
note:incomeNote.value,
amount
});
incomeAmount.value="";
incomeNote.value="";
save();
}

function addExpense(){
let amount=+expenseAmount.value;
if(amount<=0)return alert("টাকার পরিমাণ দিন");
db.expense.push({
id:Date.now(),
date:expenseDate.value||today(),
type:expenseType.value,
note:expenseNote.value,
amount
});
expenseAmount.value="";
expenseNote.value="";
save();
}

function addOwe(){
let name=oweName.value.trim(),amount=+oweAmount.value;
if(!name||amount<=0)return alert("নাম ও টাকা দিন");
db.owe.push({
id:Date.now(),name,amount,
date:oweDate.value||today(),
note:oweNote.value,
paid:false
});
oweName.value="";oweAmount.value="";oweNote.value="";
save();
}

function addGet(){
let name=getName.value.trim(),amount=+getAmount.value;
if(!name||amount<=0)return alert("নাম ও টাকা দিন");
db.get.push({
id:Date.now(),name,amount,
date:getDate.value||today(),
note:getNote.value,
paid:false
});
  getName.value="";getAmount.value="";getNote.value="";
save();
}

function del(type,id){
if(!confirm("এই হিসাব মুছে ফেলবেন?"))return;
db[type]=db[type].filter(x=>x.id!==id);
save();
}

function toggle(type,id){
let x=db[type].find(x=>x.id===id);
if(x)x.paid=!x.paid;
save();
}

function calc(){
let inc=db.income.filter(x=>inMonth(x.date)).reduce((a,x)=>a+x.amount,0);
let exp=db.expense.filter(x=>inMonth(x.date)).reduce((a,x)=>a+x.amount,0);

let owe=db.owe.filter(x=>!x.paid).reduce((a,x)=>a+x.amount,0);
let get=db.get.filter(x=>!x.paid).reduce((a,x)=>a+x.amount,0);

return{inc,exp,balance:inc-exp,owe,get,final:inc-exp-owe+get};
}

function render(){
let c=calc();

summary.innerHTML=`
<div class="stats">
<div class="stat"><b>${money(c.inc)}</b>💵 মোট আয়</div>
<div class="stat"><b>${money(c.exp)}</b>💸 মোট খরচ</div>
<div class="stat"><b>${money(c.balance)}</b>💰 আয় − খরচ</div>
<div class="stat"><b>${money(c.final)}</b>💳 আনুমানিক ব্যালেন্স</div>
</div>`;

peopleSummary.innerHTML=`
<div class="balance redbg"><b>💰 অন্যরা তোমার কাছে পাবে</b><b>${money(c.owe)}</b></div>
<div class="balance bluebg"><b>💸 তুমি অন্যদের কাছ থেকে পাবে</b><b>${money(c.get)}</b></div>`;

renderIncome();
renderExpense();
renderPeople();
renderReport();
}

function renderIncome(){
let a=db.income.filter(x=>inMonth(x.date));
incomeList.innerHTML=a.length?`
<table><tr><th>তারিখ</th><th>ধরন</th><th>বিবরণ</th><th>টাকা</th><th></th></tr>
${a.map(x=>`
<tr>
<td>${x.date}</td>
<td>${x.type==="job"?"💵 চাকরি":x.type==="car"?"🚗 গাড়ি":"💰 অন্যান্য"}</td>
<td>${esc(x.note)}</td>
<td>${money(x.amount)}</td>
<td><button class="red" style="width:auto" onclick="del('income',${x.id})">×</button></td>
</tr>`).join("")}</table>`:"এই মাসে কোনো আয় নেই।";
}

function expenseName(t){
return({
fuel:"🚗 তেল",
repair:"🔧 মেরামত",
insurance:"🛡️ Insurance",
tax:"📄 Tax",
carOther:"🚗 গাড়ি অন্যান্য",
home:"🏠 বাসা / ব্যক্তিগত",
food:"🍔 খাবার / দৈনন্দিন",
other:"💸 অন্যান্য"
})[t]||t;
}

function renderExpense(){
let a=db.expense.filter(x=>inMonth(x.date));
expenseList.innerHTML=a.length?`
<table><tr><th>তারিখ</th><th>ধরন</th><th>বিবরণ</th><th>টাকা</th><th></th></tr>
${a.map(x=>`
<tr>
<td>${x.date}</td>
<td>${expenseName(x.type)}</td>
<td>${esc(x.note)}</td>
<td>${money(x.amount)}</td>
<td><button class="red" style="width:auto" onclick="del('expense',${x.id})">×</button></td>
</tr>`).join("")}</table>`:"এই মাসে কোনো খরচ নেই।";
}

function renderPeople(){
let html="";

if(db.owe.length){
html+="<h3>💰 আমার কাছে যারা পাবে</h3>";
db.owe.forEach(x=>{
html+=`
<div class="balance redbg">
<div>
<b>${esc(x.name)}</b>
<div class="small">${money(x.amount)} • ${x.date}${x.note?" • "+esc(x.note):""}<br>${x.paid?"✅ দেওয়া হয়েছে":"⏳ এখনো দেওয়া হয়নি"}</div>
</div>
<div class="actions">
<button class="gray" onclick="toggle('owe',${x.id})">${x.paid?"ফেরত":"দিলাম"}</button>
<button class="red" onclick="del('owe',${x.id})">×</button>
</div>
</div>`;
});
}

if(db.get.length){
html+="<h3>💸 আমি যাদের কাছ থেকে পাব</h3>";
db.get.forEach(x=>{
html+=`
<div class="balance bluebg">
<div>
<b>${esc(x.name)}</b>
<div class="small">${money(x.amount)} • ${x.date}${x.note?" • "+esc(x.note):""}<br>${x.paid?"✅ টাকা পেয়েছি":"⏳ এখনো পাইনি"}</div>
</div>
<div class="actions">
<button class="gray" onclick="toggle('get',${x.id})">${x.paid?"খোলা":"পেয়েছি"}</button>
<button class="red" onclick="del('get',${x.id})">×</button>
</div>
</div>`;
});
}

peopleList.innerHTML=html||"কোনো পাওনা/দেনা নেই।";
}

function renderReport(){
let c=calc();
report.innerHTML=`
<p><b>মাস:</b> ${month()}</p>
<table>
<tr><td>💵 মোট আয়</td><td>${money(c.inc)}</td></tr>
<tr><td>💸 মোট খরচ</td><td>${money(c.exp)}</td></tr>
<tr><td>💰 আয় − খরচ</td><td>${money(c.balance)}</td></tr>
<tr><td>💰 অন্যরা তোমার কাছে পাবে</td><td>${money(c.owe)}</td></tr>
<tr><td>💸 তুমি অন্যদের কাছ থেকে পাবে</td><td>${money(c.get)}</td></tr>
<tr><td><b>💳 আনুমানিক ব্যালেন্স</b></td><td><b>${money(c.final)}</b></td></tr>
</table>`;
}

function backup(){
let blob=new Blob([JSON.stringify(db,null,2)],{type:"application/json"});
let a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="income-expense-backup.json";
a.click();
}

function restore(e){
let f=e.target.files[0];
if(!f)return;
let r=new FileReader();
r.onload=()=>{
try{
let x=JSON.parse(r.result);
if(!x.income||!x.expense||!x.owe||!x.get)throw Error();
db=x;save();alert("Restore হয়েছে ✅");
}catch{alert("Backup ফাইল সঠিক নয়।")}
};
r.readAsText(f);
}

function clearAll(){
if(!confirm("সব হিসাব মুছে ফেলবেন?"))return;
db={income:[],expense:[],owe:[],get:[]};
save();
}

month.value=new Date().toISOString().slice(0,7);
incomeDate.value=today();
expenseDate.value=today();
oweDate.value=today();
getDate.value=today();

month.addEventListener("change",render);

render();
</script>

</body>
</html>
